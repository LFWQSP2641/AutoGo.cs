<UserControl
    x:Class="AutoGo.Views.GoPlayView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:AutoGo.Views.Components"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:AutoGo.ViewModels"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="vm:GoPlayViewModel"
    mc:Ignorable="d">
    <Design.DataContext>
        <vm:GoPlayViewModel />
    </Design.DataContext>

    <Grid ColumnDefinitions="*,Auto,*" RowDefinitions="*,Auto">
        <components:GoBoardControl
            Grid.Row="0"
            Grid.Column="0"
            Margin="10"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            AnalysisPoints="{Binding AnalysisPoints}"
            BoardData="{Binding BoardData}"
            CurrentPlayer="{Binding CurrentPlayer}"
            LastMove="{Binding LastMoveCoords}"
            PointClickedCommand="{Binding HandlePointClickedCommand}" />

        <GridSplitter
            Grid.Row="0"
            Grid.Column="1"
            Background="Gray"
            Classes="Wide"
            ResizeDirection="Columns">
            <GridSplitter.Styles>
                <Style Selector="GridSplitter.Wide">
                    <Setter Property="ClipToBounds" Value="False" />
                    <Setter Property="Template">
                        <ControlTemplate>
                            <Border
                                Width="20"
                                Background="Transparent"
                                IsHitTestVisible="True">
                                <Border
                                    Width="2"
                                    HorizontalAlignment="Center"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}" />
                            </Border>
                        </ControlTemplate>
                    </Setter>
                </Style>
            </GridSplitter.Styles>
        </GridSplitter>

        <Grid
            Grid.Row="0"
            Grid.Column="2"
            Margin="10">
            <ScrollViewer x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto">
                <SelectableTextBlock
                    Margin="4"
                    FontSize="14"
                    Text="{Binding LogText}"
                    TextWrapping="Wrap" />
            </ScrollViewer>
        </Grid>

        <WrapPanel
            Grid.Row="1"
            Grid.Column="0"
            Grid.ColumnSpan="3"
            Margin="10"
            HorizontalAlignment="Stretch"
            Orientation="Horizontal">
            <TextBlock
                Margin="8"
                VerticalAlignment="Center"
                FontSize="16"
                Text="{Binding CurrentPlayer, StringFormat='Current Player: {0}'}" />
            <Button
                Margin="4"
                Command="{Binding KataGoAnalyzeCommand}"
                Content="Analysis"
                IsEnabled="{Binding !IsAnalyzing}" />
            <Button
                Margin="4"
                Command="{Binding KataGoPlayTheBestCommand}"
                Content="PlayBestMove"
                IsEnabled="{Binding !IsAnalyzing}" />
            <Button
                Margin="4"
                Command="{Binding PassTurnCommand}"
                Content="Pass" />
            <Button
                Margin="4"
                Content="Undo"
                IsEnabled="False" />
            <Button
                Margin="4"
                Command="{Binding ResetGameCommand}"
                Content="Restart" />
            <CheckBox
                Margin="4"
                Content="Auto Reply"
                IsChecked="{Binding KataGoAutoReply}" />
        </WrapPanel>
    </Grid>

</UserControl>